# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-only. Prefer a rotatable sb_secret_... key. Never expose this value in NEXT_PUBLIC_* or commit it to Git.
SUPABASE_SECRET_KEY=sb_secret_your-server-key
# Temporary legacy fallback only while migrating old deployments. Remove after all environments use SUPABASE_SECRET_KEY.
# SUPABASE_SERVICE_ROLE_KEY=legacy-service-role-key

# Apify — canonical Instagram ingestion runs from /api/cron/scrape
APIFY_API_TOKEN=your-apify-token
APIFY_ACTOR=apify~instagram-scraper
APIFY_RESULTS_LIMIT=5
APIFY_NEWER_THAN=3 days

# Protects the Vercel cron endpoint. Use a random value of at least 16 chars.
CRON_SECRET=your-random-secret-string

# Optional / future integrations (not required by the current MVP pipeline)
GEMINI_API_KEY=your-gemini-api-key
SERPAPI_KEY=your-serpapi-key
